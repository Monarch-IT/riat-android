<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_glass_oled"
    android:padding="0dp">

    <!-- Header: status tag + time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/tvWidgetStatusTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РАСПИСАНИЕ"
            android:textColor="#00E1D9"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:background="@drawable/bg_widget_tag"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvWidgetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Body: indicator bar + subject/details + notification button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="11dp"
            android:background="@drawable/bg_widget_indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Загрузка расписания…"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/tvWidgetDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnWidgetMode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_icon_btn"
            android:src="@drawable/ic_swap_cyan"
            android:scaleType="centerInside"
            android:contentDescription="Переключить режим пары" />

        <ImageButton
            android:id="@+id/btnWidgetNotify"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_icon_btn"
            android:src="@drawable/ic_bell_subtle"
            android:scaleType="centerInside"
            android:contentDescription="Настройка уведомлений" />
    </LinearLayout>

    <!-- Footer: group badge + type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp"
        android:paddingTop="5dp">

        <TextView
            android:id="@+id/tvWidgetGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#60A5FA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_widget_pill"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvWidgetFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#475569"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
